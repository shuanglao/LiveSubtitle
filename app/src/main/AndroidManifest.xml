<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 网络：首次启动需联网下载语音模型（关键！缺失会报 SecurityException: missing INTERNET permission） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 全局悬浮窗 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 开机自启（可选） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 1.16 内录通道：Android 10+ AudioPlaybackCapture 需要签名级权限，用 Shizuku 授予 -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.LiveSubtitle"
        tools:targetApi="34">
        <!-- Shizuku 授权桥：api 13.1.5 需配同版本 provider 才能握手 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 双通道：microphone（麦克风收音）+ mediaProjection（App 内录）。
             注意：只有在已持有 MediaProjection 授权令牌时才可在
             startForeground 带 mediaProjection 类型，否则系统会 DENIED。
             代码侧见 CaptionService.startForegroundSafe() 的动态 fgsType。 -->
        <service
            android:name=".CaptionService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaProjection" />

        <!-- 快捷设置磁贴：下拉通知栏一点即开字幕 -->
        <service
            android:name=".CaptionTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="实时字幕"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- ③ 层２：心跳复活接收器（AlarmManager 定时唤醒） -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />

    </application>

</manifest>